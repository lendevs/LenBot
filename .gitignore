# Frontend and site
node_modules/
.vite/
*.tsbuildinfo
website/.vitepress/dist/
website/.vitepress/cache/

# The built control plane stays out of Git.  Vite content-hashes every asset,
# so committing it turned each frontend change into a delete+add churn of ~40
# files that buried the real diff.  It is produced by `npm run build` for local
# runs and by the Node stage in deploy/current/Dockerfile for deploys; the bare
# `dist/` rule above already covers it, and this anchored rule records intent.
/src/len_bot/web/static/dist/

# Frontend source helpers are not Python installation output.
!/src/len_bot/web/frontend/src/lib/

